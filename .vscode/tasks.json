{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "..",
                "-G", "MinGW Makefiles",
                "-DCMAKE_C_COMPILER=D:/Users/Matheus/Downloads/c/bin/gcc.exe",
                "-DCMAKE_CXX_COMPILER=D:/Users/Matheus/Downloads/c/bin/g++.exe"
            ],
            "options": { "cwd": "${workspaceFolder}/build" },
            "group": "build"
        },
        {
            "label": "cmake-build",
            "type": "shell",
            "command": "D:/Users/Matheus/Downloads/c/bin/mingw32-make.exe",
            "options": { "cwd": "${workspaceFolder}/build" },
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": "cmake-configure",
            "problemMatcher": "$gcc"
        }
    ]
}
